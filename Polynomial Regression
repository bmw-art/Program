import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import PolynomialFeatures
from sklearn.linear_model import LinearRegression
from sklearn.metrics import r2_score, mean_absolute_error, mean_squared_error

df = pd.read_excel('Salary_PolynomialRegression.xlsx')

print(df.head())

X = df[['Experience']]
y = df['Salary']

poly = PolynomialFeatures(degree=2)
X_poly = poly.fit_transform(X)

X_train, X_test, y_train, y_test = train_test_split(
    X_poly, y, test_size=0.2, random_state=42
)

model = LinearRegression()
model.fit(X_train, y_train)

pred = model.predict(X_test)

print("R2 Score:", r2_score(y_test, pred))
print("MAE:", mean_absolute_error(y_test, pred))
print("RMSE:", np.sqrt(mean_squared_error(y_test, pred)))

x_range = np.linspace(X.min(), X.max(), 200).reshape(-1, 1)

x_poly = poly.transform(x_range)
y_curve = model.predict(x_poly)

plt.scatter(X, y, label='Data')
plt.plot(x_range, y_curve, color='red', label='Polynomial Curve')

plt.xlabel('Experience (Years)')
plt.ylabel('Salary')
plt.title('Polynomial Regression')
plt.legend()
plt.show()

new_exp = [[8]]

new_pred = model.predict(poly.transform(new_exp))

print("Predicted Salary for 8 years experience:", new_pred[0])
